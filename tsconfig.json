{
  "compilerOptions": {
    // Electron 43 embeds Node 24 and Chromium 14x; nothing to downlevel.
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "bundler",
    // lib/main runs in Electron's main process and needs the Node types. The entries that must
    // stay free of Node (shared, preload, renderer) are guarded by ESLint and by
    // scripts/verify-build.mjs instead of by an empty "types".
    "types": ["node"],
    "noEmit": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["lib"],
  "exclude": ["node_modules", "__tests__", "build"]
}
