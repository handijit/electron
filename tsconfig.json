{
  "extends": "@handijitcom/config/tsconfig/library.json",
  "compilerOptions": {
    // Electron 43+ (Chromium and its Node) and the engines floor run the preset's ES2023
    // natively; nothing to downlevel. The page entries keep DOM.Iterable as before.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The main-process entries use Node; the renderer entries are kept off it by ESLint and by
    // scripts/verify-build.mjs, which reads what each built entry imports.
    "types": ["node"],

    // One entry reaches another by the published name (section 21), never by a relative path;
    // in the source tree that name points at the entry's barrel. The build keeps it external.
    "paths": {
      "@handijitcom/electron": ["./lib/index.ts"],
      "@handijitcom/electron/*": ["./lib/*.ts", "./lib/*.tsx"]
    }
  }
}
